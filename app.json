{
  "expo": {
    "name": "Estoicismo Diario",
    "slug": "estoicismo-diario",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "estoicismodiario",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Citas estoicas para la vida cotidiana. Sabiduría de Marco Aurelio, Séneca, Epicteto y más filósofos estoicos.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fernandonieto.estoicismodiario"
    },
    "android": {
      "package": "com.fernandonieto.estoicismodiario",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1e293b"
      },
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1e293b"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8a05a5d1-db43-4660-ba96-568cc0797b27"
      },
      "router": {}
    }
  }
}
